DATABASE_URL=sqlite:///./quipu.db

GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro
GOOGLE_APPLICATION_CREDENTIALS=

# Agent Search (Discovery Engine) — used only by
# app/knowledge/backends/google_search.py. Auth is via Application Default
# Credentials (gcloud auth application-default login locally, or a service
# account/Workload Identity in deployment) — no key file path here.
DISCOVERY_ENGINE_DATA_STORE_ID=
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_SERVING_CONFIG_ID=default_search
DISCOVERY_ENGINE_TIMEOUT_SECONDS=10.0

# Firestore — Quipu's own workflow/execution/artifact/decision state (NOT
# enterprise knowledge). Auth via Application Default Credentials, same as
# Agent Search above. Leave FIRESTORE_DATABASE_ID unset to use the default
# database. For local dev against the Firestore emulator, set the standard
# FIRESTORE_EMULATOR_HOST env var (read automatically by the Google client,
# no Quipu-specific setting needed).
FIRESTORE_DATABASE_ID=

# Cloud Run — used only by app/core/cloud_run_client.py, the Google
# deployment adapter. Auth via Application Default Credentials, same as
# Agent Search/Firestore above — no service-account JSON key. The model
# never supplies a full image URI: CLOUD_RUN_IMAGE_REGISTRY is the
# app-controlled prefix the deploy_cloud_run tool builds the image from,
# combined with a model-supplied, regex-validated tag only.
CLOUD_RUN_IMAGE_REGISTRY=
CLOUD_RUN_ALLOWED_REGIONS=["us-central1"]
CLOUD_RUN_ALLOWED_ENVIRONMENTS=["development","staging","production"]
CLOUD_RUN_MAX_INSTANCES_CEILING=10
CLOUD_RUN_DEPLOY_TIMEOUT_SECONDS=300.0

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

LOG_LEVEL=INFO
