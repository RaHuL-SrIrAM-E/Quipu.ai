DATABASE_URL=sqlite:///./quipu.db

GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro
GOOGLE_APPLICATION_CREDENTIALS=

# Agent Search (Discovery Engine) — used only by
# app/knowledge/backends/google_search.py. Auth is via Application Default
# Credentials (gcloud auth application-default login locally, or a service
# account/Workload Identity in deployment) — no key file path here.
DISCOVERY_ENGINE_DATA_STORE_ID=
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_SERVING_CONFIG_ID=default_search
DISCOVERY_ENGINE_TIMEOUT_SECONDS=10.0

# Firestore — Quipu's own workflow/execution/artifact/decision state (NOT
# enterprise knowledge). Auth via Application Default Credentials, same as
# Agent Search above. Leave FIRESTORE_DATABASE_ID unset to use the default
# database. For local dev against the Firestore emulator, set the standard
# FIRESTORE_EMULATOR_HOST env var (read automatically by the Google client,
# no Quipu-specific setting needed).
FIRESTORE_DATABASE_ID=

# Cloud Run — used only by app/core/cloud_run_client.py, the Google
# deployment adapter. Auth via Application Default Credentials, same as
# Agent Search/Firestore above — no service-account JSON key. The model
# never supplies a full image URI: CLOUD_RUN_IMAGE_REGISTRY is the
# app-controlled prefix the deploy_cloud_run tool builds the image from,
# combined with a model-supplied, regex-validated tag only.
CLOUD_RUN_IMAGE_REGISTRY=
CLOUD_RUN_ALLOWED_REGIONS=["us-central1"]
CLOUD_RUN_ALLOWED_ENVIRONMENTS=["development","staging","production"]
CLOUD_RUN_MAX_INSTANCES_CEILING=10
CLOUD_RUN_DEPLOY_TIMEOUT_SECONDS=300.0

# Cloud Monitoring / Cloud Logging — used only by
# app/core/cloud_monitoring_client.py and app/core/cloud_logging_client.py,
# MonitoringAgent's Google observability adapters. Auth via Application
# Default Credentials, same as every other Google integration above. Reuses
# CLOUD_RUN_ALLOWED_REGIONS/CLOUD_RUN_ALLOWED_ENVIRONMENTS above as the scope
# boundary rather than a second allow-list.
MONITORING_DEFAULT_WINDOW_MINUTES=15
MONITORING_MAX_WINDOW_MINUTES=1440
MONITORING_LOG_QUERY_LIMIT=50
MONITORING_LOG_QUERY_MAX_LIMIT=200
MONITORING_MIN_LOG_SEVERITY=ERROR
MONITORING_ERROR_RATE_WARNING_THRESHOLD=0.05
MONITORING_ERROR_RATE_CRITICAL_THRESHOLD=0.15
MONITORING_API_TIMEOUT_SECONDS=30.0

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Pub/Sub — used only by app/eventing/google_pubsub_client.py, the Signal
# ingestion event-transport adapter. Auth via Application Default
# Credentials, same as every other Google integration above. Reuses
# GCP_PROJECT_ID. PUBSUB_DEAD_LETTER_TOPIC is optional subscription-level
# policy; leave unset for local/dev subscriptions without one.
PUBSUB_SIGNAL_TOPIC=
PUBSUB_SIGNAL_SUBSCRIPTION=
PUBSUB_DEAD_LETTER_TOPIC=
PUBSUB_MAX_MESSAGE_BYTES=262144
PUBSUB_PULL_MAX_MESSAGES=20
PUBSUB_API_TIMEOUT_SECONDS=30.0

# Pub/Sub Signal Consumer Worker — used only by app/eventing/worker.py.
PUBSUB_WORKER_MAX_CONCURRENCY=10
PUBSUB_WORKER_POLL_INTERVAL_SECONDS=5.0
PUBSUB_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30.0

# Detection Processor — used only by app/detection/. Reuses
# GCP_PROJECT_ID-independent settings already defined for DetectingAgent
# above (detecting_max_signals/detecting_max_window_minutes); these add
# only the per-domain window/minimum-evidence knobs the processor owns.
DETECTION_OPERATIONAL_WINDOW_MINUTES=30
DETECTION_PRODUCT_WINDOW_MINUTES=10080
DETECTION_MIN_OPERATIONAL_SIGNALS=1
DETECTION_MIN_PRODUCT_SIGNALS=2

# Remediation Verification — used only by app/verification/.
VERIFICATION_WINDOW_MINUTES=30
VERIFICATION_MINIMUM_POST_DEPLOYMENT_SIGNALS=1
VERIFICATION_MAX_SIGNALS_PER_CONDITION=20
VERIFICATION_LATENCY_P99_THRESHOLD_MS=500.0

LOG_LEVEL=INFO
